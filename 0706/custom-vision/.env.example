# Custom Vision 자격증명/설정 — 실제 값은 .env 에 채운다(.env 는 git 제외).
# Azure Portal > Custom Vision 리소스(Training/Prediction) > 키 및 엔드포인트 참고.

# 학습(Training) 리소스
VISION_TRAINING_ENDPOINT=https://<training-resource>.cognitiveservices.azure.com/
VISION_TRAINING_KEY=

# 예측(Prediction) 리소스
VISION_PREDICTION_ENDPOINT=https://<prediction-resource>.cognitiveservices.azure.com/
VISION_PREDICTION_KEY=
# 게시(publish)에 필요한 Prediction 리소스의 전체 리소스 ID
# /subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<prediction-resource>
VISION_PREDICTION_RESOURCE_ID=

# 프로젝트 선택(둘 다 선택 사항)
# - VISION_PROJECT_ID: 기존 '객체탐지(ObjectDetection)' 프로젝트 ID 를 직접 지정.
#   Classification 프로젝트는 사용 불가(프로젝트 타입은 생성 후 변경 불가).
# - VISION_PROJECT_NAME: 이름으로 찾고 없으면 새로 생성(기본 sesac015-customvision).
#VISION_PROJECT_ID=
VISION_PROJECT_NAME=sesac015-od-project1

# 게시 이터레이션 이름(기본 sesac015-object-detection-v1)
#VISION_PUBLISH_NAME=
